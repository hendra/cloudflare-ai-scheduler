{
  "name": "cloudflare-ai-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create scheduler-db",
    "db:migrate:local": "wrangler d1 migrations apply scheduler-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply scheduler-db --remote",
    "db:seed:local": "wrangler d1 execute scheduler-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute scheduler-db --remote --file=./migrations/0002_seed.sql",
    "typecheck": "tsc --noEmit",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
