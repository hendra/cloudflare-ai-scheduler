{
  "name": "cloudflare-ai-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:config": "node scripts/gen-config.mjs",
    "predev": "npm run gen:config",
    "dev": "wrangler dev",
    "predeploy": "npm run gen:config",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create scheduler-db",
    "predb:migrate:local": "npm run gen:config",
    "db:migrate:local": "wrangler d1 migrations apply scheduler-db --local",
    "predb:migrate:remote": "npm run gen:config",
    "db:migrate:remote": "wrangler d1 migrations apply scheduler-db --remote",
    "typecheck": "tsc --noEmit",
    "selfcheck": "node scripts/ai-providers-selfcheck.mjs",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
