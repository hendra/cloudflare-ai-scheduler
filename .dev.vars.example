D1_DATABASE_ID=
MANUAL_RUN_TOKEN=
CF_ACCOUNT_ID=
CF_API_TOKEN=
SLACK_BOT_TOKEN=
SLACK_JOBS_CHANNEL_ID=
SLACK_NEWS_CHANNEL_ID=
SLACK_RAILSDEV_CHANNEL_ID=
FULLSTACKWEB_PAT=
RAILSDEV_PAT=
SLACK_FULLSTACKWEBDEV_CHANNEL_ID=
# AI providers
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.3-flash-free
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Kilo AI Gateway — optional; the kilo-auto/free tier runs without a key
KILO_API_KEY=
AI_PROVIDER=opencode
AI_FALLBACKS=openrouter,groq,gemini,kilo,cloudflare
# Ollama (local development only)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e2b
INASOFT_PAT=
SLACK_INASOFT_CHANNEL_ID=
# IG Reel pipeline (GitHub Actions: image gen chain — CF → Google AI Studio → HF → Pollinations)
# CF_ACCOUNT_ID / CF_API_TOKEN above are used automatically (mapped to CF_ACCOUNT/CF_TOKEN).
# Optional fallbacks: free tiers with key (skipped silently when unset).
# Pollinations needs no key and is always the last resort (1 image per 45 s per IP).
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-nano-banana-2.1
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
POLLINATIONS_SECRET_KEY=
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_ID=
BUFFER_ORG_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OLLAMA_API_KEY=
KILO_API_KEY=
# IG Reel note: CF_ACCOUNT_ID / CF_API_TOKEN above are used automatically —
# scripts/ig_reel_daily.py maps them to the CF_ACCOUNT/CF_TOKEN names cf_image.py expects.
# Only set CF_ACCOUNT / CF_TOKEN if you need a separate account for the Reel pipeline.
